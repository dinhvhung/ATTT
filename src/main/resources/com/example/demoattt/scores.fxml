<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="900.0" style="-fx-background-color: #eef1f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demoattt.ScoreController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #1f6feb;">
         <padding>
            <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
         </padding>
         <children>
            <Label text="QUẢN LÝ ĐIỂM" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="welcomeLabel" text="Xin chào!" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#onLogout" style="-fx-background-color: white; -fx-text-fill: #1f6feb; -fx-font-weight: bold;" text="Đăng xuất" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="10.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Tìm kiếm:" />
                  <TextField fx:id="searchField" prefWidth="280.0" promptText="Mã SV / Họ tên / Môn học" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="countLabel" text="Số bản ghi: 0" />
               </children>
            </HBox>
            <TableView fx:id="scoreTable" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="sttCol" prefWidth="50.0" text="STT" />
                  <TableColumn fx:id="maSVCol" prefWidth="110.0" text="Mã SV" />
                  <TableColumn fx:id="hoTenCol" prefWidth="190.0" text="Họ và tên" />
                  <TableColumn fx:id="monHocCol" prefWidth="180.0" text="Môn học" />
                  <TableColumn fx:id="diemCol" prefWidth="80.0" text="Điểm" />
                  <TableColumn fx:id="xepLoaiCol" prefWidth="110.0" text="Xếp loại" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="290.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #d0d7de; -fx-border-width: 0 0 0 1;">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
         <children>
            <Label text="Thông tin điểm">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <Label text="Mã sinh viên" />
            <TextField fx:id="maSVField" promptText="VD: SV001" />
            <Label text="Họ và tên" />
            <TextField fx:id="hoTenField" promptText="Nhập họ và tên" />
            <Label text="Môn học" />
            <ComboBox fx:id="monHocCombo" editable="true" maxWidth="1.7976931348623157E308" promptText="Chọn hoặc nhập môn" />
            <Label text="Điểm (0 - 10)" />
            <TextField fx:id="diemField" promptText="VD: 8.5" />
            <HBox spacing="10.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAdd" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="Thêm" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onUpdate" style="-fx-background-color: #1f6feb; -fx-text-fill: white;" text="Cập nhật" HBox.hgrow="ALWAYS" />
               </children>
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onDelete" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" text="Xóa" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onClear" style="-fx-background-color: #6e7781; -fx-text-fill: white;" text="Làm mới" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="statusLabel" textFill="#1f6feb" wrapText="true" />
         </children>
      </VBox>
   </right>
</BorderPane>
